# Datos visibles en la app
STORE_NAME=Alndin
WHATSAPP_NUMBER=5492613375082
PRICE_MARKUP_PERCENT=10

# public consulta la lista de Las Beltra. snapshot usa solamente el respaldo SQL.
# mysql consulta la base directamente si tenés credenciales de solo lectura.
PRODUCT_SOURCE=public

# Ruta de las fotos: el valor por defecto ya apunta a Las Beltra.
PRODUCT_IMAGE_BASE_URL=https://lasbeltra.com.ar/uploads/catalog/

# MySQL de Hostinger: estas variables se usan solo en el servidor.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Consulta opcional si usás PRODUCT_SOURCE=mysql. Si se omite, se usa catalog_products.
# DB_PRODUCTS_QUERY=SELECT id, name, description, image_path, unit, price_cents, currency FROM catalog_products

# Alternativa si el sitio actual es WooCommerce (catálogo público).
# WOO_SITE_URL=https://tusitio.com

# Opcional: precios y unidades propios por ID de producto.
# PRODUCT_OVERRIDES_JSON={"123":{"price":2500,"unit":"kg"}}
